.home {
  box-sizing: border-box;
  min-height: 100vh;
  background: #fcf5e9;
  color: #294433;
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
}

.scene {
  position: relative;
  height: 76vw;
  max-height: 44vh;
  overflow: hidden;
}

.illustration {
  display: block;
  width: 100%;
  height: 100%;
}

.fade {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 20%;
  background: linear-gradient(to bottom, rgba(252, 245, 233, 0), #fcf5e9);
}

.copy {
  padding: 54rpx 54rpx 0;
}

.message, .description {
  display: block;
  overflow-wrap: anywhere;
}

.message {
  font-size: 1.625rem;
  font-weight: 650;
  line-height: 1.45;
}

.description {
  margin-top: 18rpx;
  max-width: 16em;
  text-wrap: balance;
  color: #536354;
  font-size: 1.0625rem;
  line-height: 1.75;
}
